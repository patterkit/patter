---
// The PatterKit marketing home. A STANDALONE page (its own header and footer, light-only),
// deliberately outside the Starlight docs chrome. Brand tokens come from src/styles/patter.css;
// the landing's own classes live in src/styles/landing.css.
//
// Shape, top to bottom: a plain header; one sentence, one paragraph, one button, and the
// hand-drawn screenplay surface; a few paragraphs for writers with the real Patterpad screenshot;
// the four runtimes as a sentence; five reasons as a plain list; the Patterpad downloads as a
// plain list; the footer. The sibling Storylets site shares the footer and nothing else.
import "../styles/patter.css";
import "../styles/landing.css";
import Newsletter from "../components/Newsletter.astro";
import Downloads from "../components/Downloads.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/"); // normalise to a trailing slash
const repo = "https://github.com/patterkit/patter";
const title = "PatterKit, an open dialogue toolkit for games";
const description =
  "Write game dialogue as a screenplay in Patterpad, then play it in Unity, Unreal, Godot, or on the web from one small file. Open source and free.";
const engines = [
  { icon: "plugin-javascript.svg", name: "JavaScript" },
  { icon: "plugin-unity.svg", name: "Unity" },
  { icon: "plugin-unreal.svg", name: "Unreal" },
  { icon: "plugin-godot.svg", name: "Godot" },
];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://patterkit.dev/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://patterkit.dev/social-card.png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://patterkit.dev/social-card.png" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>{"body{margin:0}"}</style>
  </head>
  <body>
    <div class="pt-landing">
      <!-- HEADER -->
      <header class="pt-head">
        <div class="pt-wrap pt-head-inner">
          <a class="pt-brand" href={base} aria-label="PatterKit home">
            <svg viewBox="8 25 124 112" width="33" height="30" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <g transform="translate(36.7,6) rotate(270 50 50)"><path fill="#214f4b" d="M50 8 C64 30 78 48 78 64 A28 28 0 1 1 22 64 C22 48 36 30 50 8 Z"></path></g>
              <g transform="translate(3.3,56) rotate(90 50 50)"><path fill="#d2603e" d="M50 8 C64 30 78 48 78 64 A28 28 0 1 1 22 64 C22 48 36 30 50 8 Z"></path></g>
            </svg>
            <span class="pt-wordmark">Patter<span>Kit</span></span>
          </a>
          <nav class="pt-navlinks" aria-label="Site">
            <a class="pt-navlink" href={`${base}patterpad/overview/`}>Patterpad</a>
            <a class="pt-navlink" href={`${base}play/overview/`}>Runtimes</a>
            <a class="pt-navlink" href={`${base}why/`}>Why Patter</a>
            <a class="pt-navlink" href={repo}>GitHub</a>
            <a class="pt-btn" href={`${base}getting-started/`}>Get started</a>
          </nav>
        </div>
      </header>

      <main>
        <!-- HERO: one sentence, one paragraph, one button, then the script itself -->
        <section class="pt-wrap pt-hero">
          <div class="pt-hero-copy">
            <h1 class="pt-h1">Write dialogue as a screenplay your game can play.</h1>
            <p class="pt-lead">Patter is an open toolkit for dialogue and branching narrative in games. Writers work in Patterpad, a desktop editor that reads like a script. Your game plays the result through one small file, in Unity, Unreal, Godot, or on the web.</p>
            <div class="pt-actions">
              <a class="pt-btn pt-btn-primary" href={`${base}getting-started/`}>Get started</a>
              <a class="pt-link" href={`${base}download/`}>Download</a>
            </div>
          </div>

          <!-- The screenplay surface, recreated by hand from the interactive tour. -->
          <div class="pt-screen" aria-label="A scene as it looks in Patterpad">
            <div class="pt-screen-head">
              <span class="pt-screen-title">The Crossroads</span>
              <span class="pt-screen-meta">3 blocks</span>
            </div>
            <div class="pt-screen-body">
              <p class="pt-narration">A soft chime. A warm, paper-coloured room assembles itself around you.</p>
              <div class="pt-lines">
                <span class="pt-cue">Guide</span><span class="pt-line">Hello! Welcome to Patter. I'm your guide for this little tour.</span>
                <span class="pt-cue">Guide</span><span class="pt-line">So, where would you like to start?</span>
              </div>
              <div class="pt-cond">
                <span class="pt-cond-expr">if visits(The Crossroads) == 1</span>
                <div class="pt-cond-lines">
                  <span class="pt-cue">Guide</span><span class="pt-line">Pick anything; I'll bring you right back here afterwards.</span>
                </div>
              </div>
              <div class="pt-choice">
                <svg viewBox="0 0 14 14" width="13" height="13" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M7 1 L13 7 L7 13 L1 7 Z" fill="none" stroke="#214f4b" stroke-width="1.5" /></svg>
                <span class="pt-choice-label">Lines, narration, and directions</span>
              </div>
            </div>
          </div>
        </section>

        <!-- FOR WRITERS -->
        <section class="pt-wrap pt-section">
          <h2 class="pt-h2">Built for the people who write it</h2>
          <div class="pt-prose">
            <p>Patterpad is a desktop editor with a scene laid out the way a script is, in character cues, lines, and directions. There's no markup to learn and no node graph to untangle, so a writer is productive on the first morning.</p>
            <p>Conditions and variables are edited in a side panel with a guided editor, which keeps the logic out of the prose. A play window walks the real story as you write, so you can pick choices and watch it branch without a compile step.</p>
            <p>Review comments, draft status, translation, and voice-recording scripts are built in. Everything lives in plain files on disk that you own, in git or Perforce. Patter is free, MIT-licensed, and needs no server or account.</p>
          </div>
          <figure class="pt-shot">
            <img src={`${base}doc-images/ThreeColumns.png`} width="2936" height="1634" alt="Patterpad with the scene list on the left, a scene of the interactive tour in the middle, and the inspector on the right" loading="lazy" />
          </figure>
        </section>

        <!-- THE RUNTIMES -->
        <section class="pt-wrap pt-section">
          <h2 class="pt-h2">Plays in your engine the way it played in Patterpad</h2>
          <div class="pt-prose">
            <p>Patterpad plays your story on the same runtime your game will use, so what you test at the desk is what ships: the choices, the conditions, saving and loading, even the random draws. There’s a runtime for your engine, whether that’s Unity, Unreal, Godot, or the web, and it loads the one bundle Patterpad publishes.</p>
          </div>
          <ul class="pt-engines">
            {engines.map((e) => (
              <li><img src={`${base}${e.icon}`} alt="" width="30" height="30" /><span>{e.name}</span></li>
            ))}
          </ul>
        </section>

        <!-- WHY TEAMS REACH FOR IT -->
        <section class="pt-wrap pt-section">
          <h2 class="pt-h2">Why teams reach for it</h2>
          <ul class="pt-reasons">
            <li>Scenes are plain text in your own repository, so a team's edits merge by structure instead of colliding.</li>
            <li>Coverage testing walks the story thousands of times and flags every beat a player can never reach, and the CLI can fail a build on it.</li>
            <li>Every line has a permanent id, so a translation is that line in another language and an audio take is that line's recording.</li>
            <li>Localisation comes in two modes, with a live language switch and caption cues a player can turn off.</li>
            <li>A stakeholder gets one playable HTML file or a PDF screenplay, with nothing to install.</li>
          </ul>
          <p class="pt-after"><a class="pt-link" href={`${base}why/`}>How Patter compares with Ink, Yarn, and articy</a></p>
        </section>

        <!-- DOWNLOADS -->
        <section class="pt-wrap pt-section pt-downloads">
          <h2 class="pt-h2">Download Patterpad</h2>
          <div class="pt-prose">
            <p>Patterpad is the authoring tool: the desktop editor your writers work in. It's self-contained, with nothing else to install. The runtime for your engine and the CLI are on the <a href={`${base}download/`}>download page</a>.</p>
          </div>
          <Downloads kind="patterpad" />
        </section>
      </main>

      <!-- FOOTER -->
      <footer class="pt-foot">
        <div class="pt-wrap pt-foot-signup"><Newsletter variant="landing" /></div>
        <div class="pt-wrap pt-foot-inner">
          <div class="pt-foot-brand">
            <svg viewBox="8 25 124 112" width="27" height="24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><g transform="translate(36.7,6) rotate(270 50 50)"><path fill="#57a294" d="M50 8 C64 30 78 48 78 64 A28 28 0 1 1 22 64 C22 48 36 30 50 8 Z"></path></g><g transform="translate(3.3,56) rotate(90 50 50)"><path fill="#d2603e" d="M50 8 C64 30 78 48 78 64 A28 28 0 1 1 22 64 C22 48 36 30 50 8 Z"></path></g></svg>
            <span>PatterKit</span>
          </div>
          <div class="pt-foot-links">
            <a href={`${base}why/`}>Why Patter</a>
            <a href={`${base}patterpad/overview/`}>Patterpad</a>
            <a href={`${base}play/overview/`}>Runtimes</a>
            <a href={`${base}download/`}>Download</a>
            <a href={repo}>GitHub</a>
          </div>
          <p class="pt-foot-credit">Open source under the <a href={`${base}licensing/`}>MIT licence</a>, made by <a href="https://ian.wildwinter.net" rel="author">Ian Thomas</a>.</p>
        </div>
      </footer>
    </div>
  </body>
</html>
