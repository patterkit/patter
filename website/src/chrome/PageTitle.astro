---
// Generated from patterkit/site-chrome; do not edit here, edit the source and run sync
import Default from "@astrojs/starlight/components/PageTitle.astro";
import site from "./site.mjs";
import { sectionOf } from "./extensions.mjs";

type Group = { label: string; items: string[] };

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const ext = sectionOf(Astro.url.pathname, base);
const id = Astro.locals.starlightRoute.id;
const overview = ext && id === `${ext.slug}/overview`;
const group = ext && !overview ? (ext.sidebar.items as Group[]).find((g) => g.items.includes(id))?.label : undefined;
---

{
  ext && (
    <nav class="chrome-trail" aria-label="Breadcrumb" data-extension={ext.id}>
      <a href={base}>{site.brand}</a>
      <span aria-hidden="true">/</span>
      {overview ? <span aria-current="page">{ext.name}</span> : <a href={`${base}${ext.slug}/overview/`}>{ext.name}</a>}
      {group && <span aria-hidden="true">/</span>}
      {group && <span>{group}</span>}
    </nav>
  )
}
<Default />
