node_modules/

# Extension sections, written by scripts/sync-extensions.mjs from each extension's release. Never
# committed: the pages are under the extension's own licence, not this repository's MIT one. Each
# extension's slug needs its lines here before its first sync, which refuses a slug that hasn't: one
# for its pages, and one under public/ for its play/ pages, if it has any.
src/extensions/
src/content/docs/stage/
public/stage/
src/content/docs/shot/
public/shot/
