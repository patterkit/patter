#!/bin/sh
# Keep the inlined playable-runtime blob in lockstep with the JS runtime.
#
# `packages/ops/src/playable-runtime.ts` is a GENERATED snapshot of the minified `@patterkit/runtime`
# (so `runExportHtml` can build a single self-contained playable HTML file). It is easy to change the
# runtime and forget to regenerate it - which ships an outdated engine in playable exports and is caught
# only later by the CI "Generated runtime blob is up to date" guard. This hook closes that gap: when a
# commit touches what the blob inlines, it rebuilds the runtime, regenerates the blob, and stages it, so the
# blob can never drift into a push. (CI stays the backstop for anyone who bypasses hooks with --no-verify.)
#
# Wired via `core.hooksPath = scripts/git-hooks` (set by the root `prepare` script on install).
set -e

# The blob is a MINIFIED BUNDLE (`packages/ops/scripts/gen-runtime-blob.mjs` bundles everything it reaches),
# so it inlines the workspace packages the runtime imports as well as the runtime's own source. Watching only
# `packages/runtime/src` missed that: adding exports to `@patterkit/model` on 2026-08-19 shifted the
# bundle, the hook stayed quiet, and CI caught a stale blob after the push.
#
# It inlines npm packages too, and the only ones it reaches are `@wildwinter/*` (expr, expr-specificity,
# scoperegistry, game-subtitles). A bump of one changes the blob with no source change at all: on
# 2026-10-17, 6c7eb79 moved `@wildwinter/expr` from 0.5.1 to 0.5.2, the hook stayed quiet, and CI failed.
# So when the lockfile is staged, compare the `@wildwinter/*` versions it installs with HEAD's: every one,
# a little more than the blob inlines (app-shell, say), because a rebuild that changes nothing stages
# nothing, and a list of exactly the inlined four would drift. It costs one small node run on a lockfile
# commit and nothing on any other.
bundled_source_changed() {
  git diff --cached --name-only --diff-filter=ACMR | grep -qE '^packages/(runtime|model|dialect)/src/'
}
bundled_dependency_moved() {
  git diff --cached --name-only | grep -qx 'package-lock.json' || return 1
  node -e '
    const { execSync } = require("node:child_process");
    const read = (rev) => { try { return JSON.parse(execSync(`git show ${rev}:package-lock.json`, { encoding: "utf8", maxBuffer: 1 << 28 })).packages ?? {}; } catch { return {}; } };
    const versions = (pkgs) => Object.entries(pkgs).filter(([k]) => /(^|\/)node_modules\/@wildwinter\//.test(k)).map(([k, v]) => `${k}@${v.version}`).sort().join("\n");
    process.exit(versions(read("HEAD")) === versions(read("")) ? 1 : 0);
  '
}
if bundled_source_changed || bundled_dependency_moved; then
  echo "pre-commit: bundled runtime source or a bundled dependency changed -> refreshing the playable-runtime blob"
  npm run --silent build -w @patterkit/runtime >/dev/null
  npm run --silent gen-runtime-blob -w @patterkit/ops >/dev/null
  git add packages/ops/src/playable-runtime.ts
fi
