{
  "name": "@patterkit/play-helpers",
  "version": "0.7.7",
  "description": "Thin game-integration helpers around @patterkit/runtime: save/load serialisation, runtime property setters, a state logger, the Patterpad Live Link client + hot reload, a property inspector, and audio resolution. The Patterplay JS companion, and the home of the patterplay.min.js browser drop-in (runtime + helpers under one global).",
  "type": "module",
  "license": "MIT",
  "author": "Ian Thomas",
  "homepage": "https://patterkit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patterkit/patter.git",
    "directory": "packages/play-helpers"
  },
  "bugs": "https://github.com/patterkit/patter/issues",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./patterplay.min.js": "./dist/patterplay.min.js"
  },
  "unpkg": "./dist/patterplay.min.js",
  "jsdelivr": "./dist/patterplay.min.js",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@patterkit/model": "^0.8.0",
    "@patterkit/runtime": "0.17.0"
  },
  "peerDependencies": {
    "@wildwinter/scoperegistry": ">=0.8.0 <1.0.0"
  },
  "devDependencies": {
    "@wildwinter/scoperegistry": ">=0.8.0 <1.0.0"
  }
}
