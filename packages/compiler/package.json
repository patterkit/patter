{
  "name": "@patterkit/compiler",
  "version": "1.1.2",
  "description": "Patter compiler: compile condition/effect expressions, validate them, and export source to the runtime bundle.",
  "keywords": [
    "patter",
    "patterkit",
    "dialogue",
    "interactive-fiction",
    "branching-dialogue",
    "game-dev",
    "narrative",
    "compiler",
    "expressions"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Ian Thomas",
  "homepage": "https://patterkit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patterkit/patter.git",
    "directory": "packages/compiler"
  },
  "bugs": "https://github.com/patterkit/patter/issues",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean"
  },
  "dependencies": {
    "@patterkit/model": "1.2.0",
    "@patterkit/core": "1.2.0",
    "@patterkit/dialect": "1.0.4",
    "@wildwinter/expr": "^1.0.1",
    "@wildwinter/toolkit": "^1.3.0"
  },
  "peerDependencies": {
    "@wildwinter/scoperegistry": ">=1.0.0 <2.0.0"
  },
  "devDependencies": {
    "@wildwinter/scoperegistry": ">=1.0.0 <2.0.0"
  }
}
