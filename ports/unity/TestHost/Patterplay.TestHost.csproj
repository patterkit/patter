<Project Sdk="Microsoft.NET.Sdk">

  <!-- A plain dotnet console that replays the conformance corpus through the C# runtime,
       so the port's parity is verifiable OUTSIDE Unity (CI, local). It compiles the same
       Runtime/*.cs the Unity asmdef ships, pinned to LangVersion 9 to stay Unity-safe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Patterplay.TestHost</AssemblyName>
    <RootNamespace>Patterkit.Patterplay.TestHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- The one-registry checks: the game's registry, from the game's side (ports of the JS tests). -->
    <Compile Include="OneRegistry.cs" />
    <!-- Checkpoints from the host's side: refusals, @world written back, live Restore (ports of the JS tests). -->
    <Compile Include="Checkpoints.cs" />
    <!-- Flow capture and restore from the host's side: refusals leave nothing behind, escaped ids, parked values (a port of the JS tests). -->
    <Compile Include="FlowStateChecks.cs" />
    <!-- A shuffle never draws a bag member gone ineligible, and never throws. -->
    <Compile Include="ShuffleChecks.cs" />
    <!-- A Reset, Goto or Close drops a chosen prompt still waiting to be replayed. -->
    <Compile Include="PendingChecks.cs" />
    <!-- A line's speaker label: a stale speaker string for a pair not overridden is ignored, an older prompt still to be spoken back re-resolves. -->
    <Compile Include="SpeakerLabelChecks.cs" />
    <!-- Content errors play through and are reported (OnError, the log's diagnostic entry); a bare
         snapshot and a save with no flows are refused before anything changes. -->
    <Compile Include="PlayErrorChecks.cs" />
    <!-- The corpus's decision-log cases, and OnTrace held to them. -->
    <Compile Include="LogChecks.cs" />
    <!-- The corpus's describe cases. -->
    <Compile Include="DescribeChecks.cs" />
    <!-- The corpus's outline cases (GetOutline, GetBeatSequence). -->
    <Compile Include="OutlineChecks.cs" />
    <!-- The corpus's audio cases (PatterAudioResolver). -->
    <Compile Include="AudioChecks.cs" />
    <!-- The corpus's duration cases (Bundle.EstimateLineDuration). -->
    <Compile Include="DurationChecks.cs" />
    <!-- The runtime foundations before 1.0: set-up reports, host-write refusals, the copies handed out. -->
    <Compile Include="FoundationsChecks.cs" />
    <!-- The thin runner (PatterRunner): the flow API as events (a port of the JS play-helpers tests). -->
    <Compile Include="RunnerChecks.cs" />
    <!-- The registry corpus runner, vendored from expr/ports/unity/testing. -->
    <Compile Include="RegistryCorpus.cs" />
    <Compile Include="../Patterplay/Runtime/**/*.cs" />
    <!-- Runtime/Unity/* depends on UnityEngine (PatterBundleAsset); not part of the headless verify. -->
    <Compile Remove="../Patterplay/Runtime/Unity/**/*.cs" />
  </ItemGroup>

  <!-- The Unity .patterc loader uses Newtonsoft (com.unity.nuget.newtonsoft-json in Unity);
       referencing the same namespace here lets the TestHost verify that loader too. -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
